{
  "manifest_version": 3,
  "name": "UMKWifi",
  "version": "1.0.0",
  "icons": 
  {
    "128": "icons/logo_128.png"
  },
  "description": "Automatically fills and submits supported campus Wi-Fi captive portals.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://1.1.1.2/webAuth/*",
    "*://*/webAuth/*",
    "http://1.1.1.2/ac_portal/*",
    "*://*/ac_portal/*"
  ],
  "action": {
    "default_title": "Campus Wi-Fi Auto Login",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://1.1.1.2/webAuth/*",
        "*://*/webAuth/*",
        "http://1.1.1.2/ac_portal/*",
        "*://*/ac_portal/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
