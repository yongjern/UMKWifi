{
  "manifest_version": 3,
  "name": "UMKWifi by Yong",
  "version": "1.0.3",
  "icons": 
  {
    "128": "icons/logo_128.png"
  },
  "description": "Automatically fills and submits supported campus Wi-Fi captive portals.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://1.1.1.2/webAuth/*",
    "*://*/webAuth/*",
    "http://1.1.1.2/ac_portal/*",
    "*://*/ac_portal/*",
    "http://1.1.1.2/homepage/*",
    "*://*/homepage/*",
    "http://10.255.255.1/*"
  ],
  "action": {
    "default_title": "UMKWifi - Fill your information",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://1.1.1.2/webAuth/*",
        "*://*/webAuth/*",
        "http://1.1.1.2/ac_portal/*",
        "*://*/ac_portal/*",
        "http://1.1.1.2/homepage/*",
        "*://*/homepage/*",
        "http://10.255.255.1/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
